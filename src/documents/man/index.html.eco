---
title: "man"
---
<ul>
    <% for page in @getCollection("manpages").toJSON(): %>
        <% if page.id isnt @document.id : %>
            <li>
                <a href="<%= page.url %>">
                    <%= page.basename %>
                </a>
            </li>
        <% end %>
    <% end %>
</ul>