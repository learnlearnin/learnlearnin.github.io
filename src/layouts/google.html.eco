<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Site Properities -->
  <title><%= @getPreparedTitle() %></title>
  <meta property="og:title" content="<%= @getPreparedTitle() %>" />
  <meta property="og:description" name="description" content="<%= @getPreparedDescription() %>" />
  <% if @document.img: %><meta property="og:image" content="/images/<%- @document.img %>" /><% end %>
  <meta property="og:url" content="<%= @getAbsoluteUrl() %>" />
  <meta name="keywords" content="<%= @getPreparedKeywords() %>" />
  <%- @getBlock('meta').toHTML() %>

  <link rel="canonical" href="<%= @getAbsoluteUrl() %>" />
  <link rel="shortcut icon" type="image/png" href="/LofL.png" />
  <link rel="apple-touch-icon" type="image/png" href="/LofL128.png" />
  <link href="https://asd.learnlearn.in/feed.atom" type="application/atom+xml" rel="alternate" title="Sitewide ATOM Feed" />
</head>
<body>
  <script type="text/javascript">
    var host = "learnlearn.in";
    if ((host == window.location.host) && (window.location.protocol != 'https:')) {
      window.location = window.location.toString().replace(/^http:/, "https:");
    }
  </script>
  <% if @document.googlelink: %>
  <script type="text/javascript">
    window.location = "<%- @document.googlelink %>";
  </script>  
  <% end %> 

      <%- @content %>
</body>
</html>
